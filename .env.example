# Names only. Set real values in Vercel (Project Settings > Environment Variables)
# or in a local .env.local file, which git ignores. Never commit values.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
# Optional, Preview only: a copy of the Base for testing
LARK_BASE_TOKEN_TEST=
# At least 32 random characters. Signs the session cookie.
SESSION_SECRET=
# Optional. Open assigned tasks at or below this count = "free". Default 3.
FREE_THRESHOLD=
# Editing switch. Leave empty (off) until writes are approved. 1 = leaders can save to Lark.
LARK_WRITES_ENABLED=
# Optional, preview deployments only. 1 = allow /dev-login mock sign-in. Never set in production.
DEV_LOGIN=
